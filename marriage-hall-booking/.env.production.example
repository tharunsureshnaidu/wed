# Production configuration template.
#
# Copy to .env on the server, fill every value, and keep it out of git.
# The service validates this at boot and REFUSES TO START if anything here is
# still a development value - see pkg/config/validate.go.

# ---- identity -----------------------------------------------------------
# This is what turns the validation from warnings into a hard failure.
APP_ENV=production

# Embedded in owner acknowledge links sent by SMS/WhatsApp, and in every
# uploaded media URL. Must be the public HTTPS address, not localhost.
PUBLIC_BASE_URL=https://api.yourdomain.com

# CIDRs or bare IPs allowed to set X-Forwarded-For. 127.0.0.1 is right for the
# DEPLOY.md layout (nginx on the same host); behind a cloud load balancer use
# its subnet instead. Left empty behind a proxy, every request appears to come
# from the proxy and the rate limiter treats all users as one caller. Set
# wrongly wide, a client can forge its own IP and bypass the limiter entirely.
TRUSTED_PROXIES=127.0.0.1

# ---- secrets (generate fresh, never reuse the dev values) ----------------
# openssl rand -base64 48
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- database -----------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=venue
DB_USERNAME=
DB_PASSWORD=
# require at minimum for a remote database; disable sends the password and
# every row in clear text.
DB_SSLMODE=require
# Connection pool size per process (api and worker each). Default 8.
DB_MAX_CONNS=8

# ---- infrastructure -----------------------------------------------------
# Redis 7+ (or Valkey): the rate limiter uses EXPIRE ... NX.
REDIS_ADDR=
KAFKA_BROKERS=
SERVER_PORT=8080

# ---- must NOT be set in production --------------------------------------
# OTP_FIXED_CODE   - would make every OTP the same known value
LOG_OTP_CODES=false

# Exact origins only. A '*' here lets any site call this API with a user's
# credentials.
CORS_ORIGINS=https://app.yourdomain.com

FRONTEND_RESET_PASSWORD_URL=https://app.yourdomain.com/reset-password
LOG_LEVEL=info
# json is the production default; text is for a person tailing a terminal.
LOG_FORMAT=json

# ---- notification vendors ----------------------------------------------
# Every channel degrades to logging when its credentials are absent - but
# nothing is actually delivered. "notify: would send" in the log means missing
# config, not a failure. At least one of email or SMS is REQUIRED in
# production: OTPs and password-reset links have no other way to arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved Meta template name; WhatsApp refuses free text outside a 24h window.
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en_US

# Service-account JSON for push. Without these, device tokens are stored but
# no push is ever delivered.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Where ops notifications go. One watched inbox, not every admin account.
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# ---- storage ------------------------------------------------------------
# REQUIRED in production: without a bucket media goes to local disk, is lost
# on redeploy, and is invisible to the worker on another host.
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: serve media through a CDN domain instead of the bucket URL.
AWS_CLOUDFRONT_DOMAIN=
