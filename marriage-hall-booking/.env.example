SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=venue
DB_USERNAME=postgres
DB_PASSWORD=
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
LOG_OTP_CODES=true
PAYMENT_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=text

# --- media storage ---
# With AWS_S3_BUCKET set, uploads go to S3. Leave it empty and media is written
# to ./uploads and served by the API - fine for development, but a container
# filesystem loses every upload on redeploy, so set it in production.
AWS_S3_BUCKET=
AWS_S3_REGION=eu-north-1
# Read by the AWS SDK's default credential chain; leave unset on EC2/ECS with an
# instance role. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN in front of the bucket. Empty serves from S3 directly, which is
# what Java does (its publicUrl is https://{bucket}.s3.amazonaws.com/{key}).
AWS_CLOUDFRONT_DOMAIN=

# --- notifications ---
# Every channel below degrades to logging ("would send") when its credentials
# are absent, so the retry pipeline runs on a dev box with no vendor account.
# Filling in a channel's credentials switches only that channel to real sending.

# Email (SMTP). SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (Twilio). In India an SMS sender ID and templates must also be
# DLT-registered before delivery works.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp (Meta Cloud API). WHATSAPP_TEMPLATE must be an APPROVED template
# name: Meta rejects free-form text to anyone who has not messaged the business
# in the last 24h. Leaving it empty sends plain text, which works only inside
# that window - fine for testing, not for production.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en_US

# How often an unacknowledged owner is chased again, and how often the worker
# looks for due rows. NOTIFY_TICK only controls promptness, not frequency.
NOTIFY_RETRY_EVERY=30m
NOTIFY_TICK=30s

# Ops copy of every booking, chased until an admin acknowledges it. One watched
# address rather than every ROLE_ADMIN user: that role is held by dozens of
# accounts, and fanning out to all of them bills a real message each, per
# channel, per booking. Leave empty to send no admin copy at all.
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# Where the one-tap acknowledge link points. Must be an address the owner's
# phone can reach, so a public hostname in production - not localhost. Empty
# means notifications carry no link and the recipient must use the app.
PUBLIC_BASE_URL=http://localhost:8080

# --- push notifications (FCM) ---
# Firebase Cloud Messaging. Absent credentials mean PUSH logs instead of
# sending, like every other channel. The mobile/web app must register device
# tokens via POST /api/v1/devices before anything can be delivered.
#
# FCM_CREDENTIALS_FILE is the service-account JSON downloaded from
# Firebase Console > Project settings > Service accounts.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# --- geo-targeted announcements ---
# How far a "near you" announcement reaches. New venue approvals, new amenities
# and new coupons are pushed to customers within this radius of the venue.
#
# PUSH only, deliberately: this is marketing. SMS and WhatsApp bill per message,
# so a coupon launch to 2000 nearby users would be a real invoice.
GEO_RADIUS_KM=50
