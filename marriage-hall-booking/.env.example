SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=venue
DB_USERNAME=postgres
DB_PASSWORD=
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
LOG_OTP_CODES=true
PAYMENT_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=text

# --- media storage ---
# With AWS_S3_BUCKET set, uploads go to S3. Leave it empty and media is written
# to ./uploads and served by the API - fine for development, but a container
# filesystem loses every upload on redeploy, so set it in production.
AWS_S3_BUCKET=
AWS_S3_REGION=eu-north-1
# Read by the AWS SDK's default credential chain; leave unset on EC2/ECS with an
# instance role. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN in front of the bucket. Empty serves from S3 directly, which is
# what Java does (its publicUrl is https://{bucket}.s3.amazonaws.com/{key}).
AWS_CLOUDFRONT_DOMAIN=
